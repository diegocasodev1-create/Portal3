# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.

# Azure SQL
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=

# Portal Externo (Power Pages): solo para el enlace del correo de bienvenida.
# Opcional: el valor por defecto es este mismo.
PORTAL_BASE_URL=https://miragroup-portal-externo.powerappsportals.com

# Latidos de sesión (POST /api/latido)
# Sitio Energía: su clave pública valida los tokens de los latidos de Energía
ENERGIA_PORTAL_URL=https://portalenergia.powerappsportals.com
# Orígenes permitidos por CORS en /api/latido, separados por coma
LATIDO_ORIGINS=https://portalenergia.powerappsportals.com,https://site-oaciopruebas2.powerappsportals.com

# Sesión de la app: firma la cookie y los permisos de edición de /administradores
# (valor aleatorio largo, distinto en cada ambiente). El login usa core.AdministradoresPortal.
SESSION_SECRET=
SESSION_MAX_AGE_MIN=60

# Microsoft Graph (envío de correo)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_SENDER=
MAIL_ENABLED=false

# Microsoft Entra External ID (cuentas de acceso al portal; ingreso con código por correo)
EXTID_ENABLED=false
EXTID_TENANT_ID=
EXTID_CLIENT_ID=
EXTID_CLIENT_SECRET=
EXTID_DOMAIN=

LOG_LEVEL=INFO
